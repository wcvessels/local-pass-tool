{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LocalPass",
  "version": "1.0.0",
  "identifier": "com.wcvessels.localpass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalPass",
        "url": "index.html",
        "create": false,
        "width": 400,
        "height": 640,
        "center": true,
        "visible": false,
        "focus": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "incognito": true,
        "generalAutofillEnabled": false,
        "allowLinkPreview": false,
        "dragDropEnabled": false,
        "devtools": false,
        "browserExtensionsEnabled": false,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": true
      },
      {
        "label": "about",
        "title": "About LocalPass",
        "url": "index.html?view=about",
        "create": false,
        "width": 320,
        "height": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "skipTaskbar": true,
        "incognito": true,
        "generalAutofillEnabled": false,
        "allowLinkPreview": false,
        "dragDropEnabled": false,
        "devtools": false,
        "browserExtensionsEnabled": false,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": ["localpass-main", "localpass-about"],
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; media-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; media-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "createUpdaterArtifacts": false
  }
}
